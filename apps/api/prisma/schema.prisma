
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String    @id @default(uuid())
  supabaseUserId String?   @unique
  name           String
  email          String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resumes        Resume[]
  sessions       Session[]

  @@map("users")
}

model Resume {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  extractedText String
  parsedProfile String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Slice A — Live Session
// ---------------------------------------------------------------------------

enum SessionStatus {
  LIVE
  ENDED
}

enum TurnSpeaker {
  AI
  CANDIDATE
}

model Session {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  status    SessionStatus @default(LIVE)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  createdAt DateTime      @default(now())
  turns     Turn[]
  jobs      Job[]
  feedback  Feedback?

  @@index([userId])
  @@map("sessions")
}

model Turn {
  id           String      @id @default(uuid())
  sessionId    String
  session      Session     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnIndex    Int
  speaker      TurnSpeaker
  text         String
  timestampSec Float
  createdAt    DateTime    @default(now())

  @@index([sessionId])
  @@map("turns")
}

// Postgres job queue inserts a `session.ended` row in the same
// transaction that ends the session; workers claim rows with
// SELECT ... FOR UPDATE SKIP LOCKED (services/job-queue.service.ts).
// sessionId is optional so jobs that are not about one session (the
// retention purge) can share the table.
model Job {
  id        String    @id @default(uuid())
  type      String
  sessionId String?
  session   Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payload   Json      @default("{}")
  status    String    @default("pending") // pending | processing | completed | failed
  attempts  Int       @default(0)
  lockedBy  String?
  lockedAt  DateTime?
  lastError String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([sessionId])
  @@index([status, createdAt])
  @@map("jobs")
}

// One evaluation per session (FB2 table; FB3 fills it, FB1 shows it).
model Feedback {
  id        String   @id @default(uuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status    String   @default("pending") // pending | ready | failed
  summary   String?
  scores    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("feedback")
}
