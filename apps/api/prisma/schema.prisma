generator client {
  provider      = "prisma-client-js"
  // "native" for laptops and CI; the Debian/OpenSSL 3 engine for the Cloud Run image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  supabaseUserId String?   @unique
  name           String
  email          String    @unique
  passwordHash   String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resumes        Resume[]
  sessions       Session[]

  @@map("users")
}

model Resume {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  fileName      String
  extractedText String
  parsedProfile String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Slice A — Live Session
// ---------------------------------------------------------------------------

enum SessionStatus {
  LIVE
  ENDED
}

enum TurnSpeaker {
  AI
  CANDIDATE
}

model Session {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  role      String
  status    SessionStatus @default(LIVE)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  createdAt DateTime      @default(now())
  turns     Turn[]
  feedback  Feedback?

  @@index([userId])
  @@map("sessions")
}

model Turn {
  id           String      @id @default(uuid())
  sessionId    String
  session      Session     @relation(fields: [sessionId], references: [id])
  turnIndex    Int
  speaker      TurnSpeaker
  text         String
  timestampSec Float
  createdAt    DateTime    @default(now())

  @@index([sessionId])
  @@map("turns")
}

// One evaluation per session (direct evaluation on session end fills it, results screen shows it).
model Feedback {
  id        String   @id @default(uuid())
  sessionId String   @unique
  session   Session  @relation(fields: [sessionId], references: [id])
  status    String   @default("pending") // pending | ready | failed
  summary   String?
  scores    Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("feedback")
}
