# Copy to .env and replace every placeholder. .env is never committed; these values are server-only.
PORT=3000
# Browser origin allowed by CORS (the Vite dev server by default).
WEB_ORIGIN=http://localhost:5173
# Supabase project → Settings → API. The service-role key must never reach the browser.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Supabase project → Settings → Database → connection string. Prisma reads this.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres"
# Server-only Gemini key (resume analysis).
GEMINI_API_KEY=YOUR_GEMINI_KEY
# Optional, tests only: a disposable Postgres with the migrations applied (never the shared database).
# When set, `bun run test` also runs the job-queue tests against it.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interview_test"
