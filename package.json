    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "happy-dom": "^20.14.5",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vitest": "^5.0.2"
  }
}
